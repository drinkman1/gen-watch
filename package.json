    "local:dry": "node src/scan-local.mjs --dry",
    "dashboard": "node src/dashboard.mjs",
    "check": "node src/selftest.mjs"
  },
  "dependencies": {
    "playwright": "^1.49.1"
  },
  "engines": {
    "node": ">=20"
  }
}
